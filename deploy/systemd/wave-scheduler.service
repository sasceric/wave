[Unit]
Description=Dispatch due Wave scheduled tasks
After=postgresql.service

[Service]
Type=oneshot
User=steelcodeweb
Group=steelcodeweb
WorkingDirectory=/home/steelcodeweb/web/wave.ba/public_html
Environment=APP_ENV=prod
Environment=APP_DEBUG=0
ExecStart=/usr/bin/php8.4 bin/console app:scheduled-tasks dispatch --env=prod --no-debug --no-interaction
NoNewPrivileges=true
PrivateTmp=true
UMask=0027
