###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=wave-development-secret-change-for-production
APP_SHARE_DIR=var/share
APP_BASE_URL=http://127.0.0.1:8000
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=%env(MAIL_MAILER)%://%env(urlencode:MAIL_USERNAME)%:%env(urlencode:MAIL_PASSWORD)%@%env(MAIL_HOST)%:%env(int:MAIL_PORT)%?require_tls=true
###< symfony/mailer ###

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL)
MERCURE_URL=http://127.0.0.1:3000/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=http://127.0.0.1:3000/.well-known/mercure
# Local development only. Override all Mercure secrets in deployment environment variables.
MERCURE_JWT_SECRET="wave-local-development-mercure-secret-change-for-production"
MERCURE_ISSUER=https://wave.local
###< symfony/mercure-bundle ###
